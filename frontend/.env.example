# Copy to .env.local for local overrides (gitignored).

# Base URL the frontend uses for API calls. Left empty, requests go to same-origin
# "/api/*" which vite.config.ts proxies to the backend in dev.
VITE_API_URL=

# Where the dev-server proxy forwards /api/* to. Ignored in Docker (set in
# docker-compose.dev.yml instead), used when running `npm run dev` on the host.
VITE_API_PROXY_TARGET=http://localhost:8111

# logger (src/lib/logger.ts) is on by default in dev, off in prod builds. Override either way
# with "true"/"false". Leave unset to use the default.
VITE_ENABLE_DEBUG_LOGS=

# Caps logger verbosity: error|warn|info|debug (default "info").
VITE_LOG_LEVEL=
