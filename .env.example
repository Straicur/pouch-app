# Vars consumed by the root docker-compose.yml. Copy to .env for local overrides
# (docker compose auto-loads .env from the project root). Backend-specific vars
# (DB credentials, JWT keys, ...) live in backend/.env / backend/.env.local — see
# backend/README.md.

SERVER_NAME=localhost
POSTGRES_VERSION=16

MINIO_ROOT_USER=pouch
MINIO_ROOT_PASSWORD=pouch-dev-secret
MINIO_BUCKET=pouch
