# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET=''
# POSTGRES_PASSWORD/JWT_*/DATABASE_URL: not set here, even blank — see
# backend/.env for why. Real values go in .env.test.local (gitignored).

# OriginCheckListener — off here, see its own docblock + the comment next
# to CSRF_ORIGIN_CHECK_ENABLED in backend/.env.
CSRF_ORIGIN_CHECK_ENABLED=0

# A subdirectory of the same backup-data volume mount (see backend/.env),
# not a separate one — keeps BackupServiceTest's own backups from mixing
# with (or being pruned alongside) whatever backup-scheduler produces in dev.
BACKUP_DIR=/var/backups/pouch/test
